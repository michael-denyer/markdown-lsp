#!/usr/bin/env sh
# Launches `marksman server`. If `marksman` isn't on PATH, exits with a clear
# install hint so Claude Code surfaces the fix rather than a cryptic
# "command not found" error.

set -eu

if ! command -v marksman >/dev/null 2>&1; then
  printf 'marksman not found on PATH.\n' >&2
  printf 'Install it with one of:\n' >&2
  printf '  brew install marksman\n' >&2
  printf '  # or download a binary from:\n' >&2
  printf '  #   https://github.com/artempyanykh/marksman/releases\n' >&2
  exit 127
fi

exec marksman server "$@"
